# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore build and test binaries.
bin/
.git/
.beads/
.idea/
.vscode/
*.out
cover.out
coverage.out
testbin/
dist/
# Tests are never production assets — keep them out of every image build context.
**/*_test.go
**/*.bats
**/test/
